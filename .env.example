# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/prijslijst_dev

# ─── JWT Auth (genereer met: openssl rand -hex 32) ───────────────────────────
JWT_SECRET_KEY=vervang-dit-met-een-random-64-char-string

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-super-secret-key-change-this
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Komma-gescheiden lijst van toegestane origins
# Productie voorbeeld: https://prijslijst.railway.app,https://jouwdomain.nl
ALLOWED_ORIGINS=http://localhost:3000

# ─── Google Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── File upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Environment ─────────────────────────────────────────────────────────────
# Zet op "production" op Railway — verbergt /docs endpoint
ENVIRONMENT=development
